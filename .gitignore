#--------------------------------------------------------------------
# Operating Specific Junk Files
#--------------------------------------------------------------------
# OS X
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.directory
.Trash-*

#--------------------------------------------------------------------
# Environment & Sensitive Credentials (NEVER COMMIT)
#--------------------------------------------------------------------
.env
.env.local
.env.production
.env.development
.vagrant
Vagrantfile

#--------------------------------------------------------------------
# Temporary & Log Files
#--------------------------------------------------------------------
/writable/cache/*
!/writable/cache/index.html
!/writable/cache/.gitkeep

/writable/logs/*
!/writable/logs/index.html
!/writable/logs/.gitkeep

/writable/session/*
!/writable/session/index.html
!/writable/session/.gitkeep

/writable/uploads/*
!/writable/uploads/index.html
!/writable/uploads/.gitkeep

/writable/debugbar/*
!/writable/debugbar/index.html
!/writable/debugbar/.gitkeep

*.log
php_errors.log

#--------------------------------------------------------------------
# User Uploaded Media & Attachments (Ignore files, preserve folders)
#--------------------------------------------------------------------
/uploads/*
!/uploads/.gitkeep
!/uploads/index.html

/public/uploads/*
!/public/uploads/.gitkeep
!/public/uploads/index.html

/public/uploads/courses/*
!/public/uploads/courses/.gitkeep

/public/uploads/lessons/*
!/public/uploads/lessons/.gitkeep

/public/uploads/materials/*
!/public/uploads/materials/.gitkeep

/public/uploads/assignments/*
!/public/uploads/assignments/.gitkeep

/public/uploads/internships/*
!/public/uploads/internships/.gitkeep

#--------------------------------------------------------------------
# Composer & Node Dependencies
#--------------------------------------------------------------------
vendor/
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

#--------------------------------------------------------------------
# Scratch, Test & Debug Scripts
#--------------------------------------------------------------------
scratch/
test_*.php
scratch_*.php
check_*.php
fix_*.php
inspect_*.php
*.sql
*.sqlite
*.bak
*.tmp
*.zip
*.tar.gz
*.rar
*.7z

#--------------------------------------------------------------------
# IDE & Tool Configs
#--------------------------------------------------------------------
.idea/
*.iml
.vscode/
/nbproject/
/build/
/dist/
.php-version
.phpintel
/phpunit.xml
/results/
/tests/coverage*
.gemini/
.agents/
